# Butterfly PHP — пример конфигурации. Скопируйте в .env и заполните.
APP_ENV=production
APP_URL=https://example.ru

DB_HOST=localhost
DB_PORT=3306
DB_NAME=butterfly
DB_USER=butterfly
DB_PASS=смените_пароль

# 1 — cookie только по HTTPS (обязательно на проде), 0 — локальная разработка
COOKIE_SECURE=1
